
CREATE TABLE User (
    id TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    display_name TEXT NOT NULL,
    last_synced_at INTEGER
);

selectUserById:
    SELECT *
    FROM User
    WHERE id = ?;

insertUser:
    INSERT INTO User (
        id,
        username,
        display_name,
        last_synced_at
    )
    VALUES (?,?,?,?);



