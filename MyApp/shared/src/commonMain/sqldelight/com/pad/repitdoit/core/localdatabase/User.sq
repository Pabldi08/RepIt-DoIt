-- Schema conventions: UUIDs are generated by the application and stored as TEXT.
-- Dates are application-provided Unix milliseconds; no SQL clock defaults.
-- Foreign keys MUST be enabled on every connection before transactions.
-- Local role flags are metadata, not authoritative backend permissions.
-- Username uniqueness uses SQLite's default case-sensitive collation.
CREATE TABLE User (
    id TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL UNIQUE CHECK (length(trim(username)) > 0),
    display_name TEXT NOT NULL CHECK (length(trim(display_name)) > 0),
    last_synced_at INTEGER,
    role TEXT NOT NULL DEFAULT 'USER' CHECK (role IN ('USER', 'ADMIN')),
    is_trainer INTEGER NOT NULL DEFAULT 0 CHECK (is_trainer IN (0, 1))
);

selectUserById:
    SELECT *
    FROM User
    WHERE id = ?;

insertUser:
    INSERT INTO User (
        id,
        username,
        display_name,
        last_synced_at
    )
    VALUES (?,?,?,?);

selectAllUsers:
SELECT * FROM User ORDER BY username ASC;

selectUserByUsername:
SELECT * FROM User WHERE username = :username;

-- Local metadata only. Authorization is enforced by business logic/backend.
updateUser:
UPDATE User
SET username = :username,
    display_name = :display_name,
    last_synced_at = :last_synced_at,
    role = :role,
    is_trainer = :is_trainer
WHERE id = :id;

-- Referenced users cannot be deleted while RESTRICT relationships remain.
deleteUser:
DELETE FROM User WHERE id = :id;



