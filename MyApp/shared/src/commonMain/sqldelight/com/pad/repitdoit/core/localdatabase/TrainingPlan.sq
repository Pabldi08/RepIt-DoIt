
CREATE TABLE TrainingPlan (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    name TEXT NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,

    FOREIGN KEY (user_id)
        REFERENCES User(id)
        ON DELETE RESTRICT,

    UNIQUE (id, user_id),

    CHECK (length(trim(name)) > 0),
    CHECK (is_active IN (0, 1)),
    CHECK (updated_at >= created_at)
);

CREATE UNIQUE INDEX idx_training_plan_active
ON TrainingPlan(user_id)
WHERE is_active = 1;

CREATE INDEX idx_training_plan_user
ON TrainingPlan(user_id);

selectPlansByUser:
SELECT *
FROM TrainingPlan
WHERE user_id = ?
ORDER BY name COLLATE NOCASE ASC, name ASC, id ASC;

selectPlanById:
SELECT *
FROM TrainingPlan
WHERE id = ?
  AND user_id = ?;

selectActivePlan:
SELECT *
FROM TrainingPlan
WHERE user_id = ?
  AND is_active = 1;

insertTrainingPlan:
INSERT INTO TrainingPlan (
    id,
    user_id,
    name,
    is_active,
    created_at,
    updated_at
)
VALUES (?, ?, ?, 0, ?, ?);

updateTrainingPlan:
UPDATE TrainingPlan
SET
    name = ?,
    updated_at = ?
WHERE id = ?
  AND user_id = ?;

deactivateUserPlans:
UPDATE TrainingPlan
SET
    is_active = 0,
    updated_at = ?
WHERE user_id = ?
  AND is_active = 1;

activateTrainingPlan:
UPDATE TrainingPlan
SET
    is_active = 1,
    updated_at = ?
WHERE id = ?
  AND user_id = ?;

deleteTrainingPlan:
DELETE FROM TrainingPlan
WHERE id = ?
  AND user_id = ?;

-- Schedule operations are exposed here so they belong to trainingPlanQueries.
-- Archived workouts are kept in storage but omitted from the visible schedule.
selectPlanSchedule:
SELECT
    WorkoutSchedule.id AS schedule_id,
    WorkoutSchedule.training_plan_id,
    WorkoutSchedule.workout_id,
    WorkoutSchedule.weekday,
    WorkoutSchedule.position,
    Workout.name AS workout_name,
    Workout.image_url AS workout_image_url,
    (
        SELECT COUNT(*)
        FROM WorkoutExercise
        WHERE WorkoutExercise.workout_id = WorkoutSchedule.workout_id
    ) AS num_ex
FROM WorkoutSchedule
INNER JOIN TrainingPlan
    ON TrainingPlan.id = WorkoutSchedule.training_plan_id
    AND TrainingPlan.user_id = WorkoutSchedule.user_id
INNER JOIN Workout
    ON Workout.id = WorkoutSchedule.workout_id
    AND Workout.user_id = WorkoutSchedule.user_id
WHERE TrainingPlan.id = :plan_id
  AND TrainingPlan.user_id = :user_id
  AND Workout.archived_at IS NULL
ORDER BY WorkoutSchedule.weekday ASC, WorkoutSchedule.position ASC;

-- Includes hidden entries, useful when validating a move/removal in the repository.
selectPlanScheduleEntry:
SELECT * FROM WorkoutSchedule
WHERE id = :schedule_id
  AND training_plan_id = :plan_id
  AND user_id = :user_id;

-- Appends a workout to a day. An invalid owner, plan or archived workout inserts no row.
-- Call inside the same transaction as touchTrainingPlan and validate the affected entry.
addWorkoutToPlan:
INSERT INTO WorkoutSchedule (
    id, user_id, training_plan_id, workout_id, weekday, position
)
SELECT
    :schedule_id,
    TrainingPlan.user_id,
    TrainingPlan.id,
    Workout.id,
    :weekday,
    (
        SELECT COALESCE(MAX(WorkoutSchedule.position), -1) + 1
        FROM WorkoutSchedule
        WHERE WorkoutSchedule.training_plan_id = :plan_id
          AND WorkoutSchedule.user_id = :user_id
          AND WorkoutSchedule.weekday = :weekday
    )
FROM TrainingPlan
INNER JOIN Workout ON Workout.user_id = TrainingPlan.user_id
WHERE TrainingPlan.id = :plan_id
  AND TrainingPlan.user_id = :user_id
  AND Workout.id = :workout_id
  AND Workout.archived_at IS NULL;

-- A schedule ID identifies an occurrence; removing it never deletes the workout itself.
removeWorkoutFromPlan:
DELETE FROM WorkoutSchedule
WHERE id = :schedule_id
  AND training_plan_id = :plan_id
  AND user_id = :user_id;

-- Moves an occurrence to the end of a different day, without position collisions.
moveWorkoutToPlanDay:
UPDATE WorkoutSchedule
SET weekday = :weekday,
    position = (
        SELECT COALESCE(MAX(target.position), -1) + 1
        FROM WorkoutSchedule AS target
        WHERE target.training_plan_id = :plan_id
          AND target.user_id = :user_id
          AND target.weekday = :weekday
    )
WHERE id = :schedule_id
  AND training_plan_id = :plan_id
  AND user_id = :user_id
  AND weekday != :weekday;

clearPlanDay:
DELETE FROM WorkoutSchedule
WHERE training_plan_id = :plan_id
  AND user_id = :user_id
  AND weekday = :weekday;

clearPlanSchedule:
DELETE FROM WorkoutSchedule
WHERE training_plan_id = :plan_id
  AND user_id = :user_id;

-- Update the parent after a schedule edit, in the same transaction.
touchTrainingPlan:
UPDATE TrainingPlan
SET updated_at = MAX(updated_at, :updated_at)
WHERE id = :plan_id
  AND user_id = :user_id;
