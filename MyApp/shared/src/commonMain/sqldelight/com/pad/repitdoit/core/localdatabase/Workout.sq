
CREATE TABLE Workout (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    estimated_time INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    archived_at INTEGER,

    FOREIGN KEY (user_id)
        REFERENCES User(id)
        ON DELETE RESTRICT,

    UNIQUE (id, user_id),

    CHECK (length(trim(name)) > 0),
    CHECK (
        estimated_time IS NULL
        OR estimated_time > 0
    ),
    CHECK (updated_at >= created_at)
);

CREATE INDEX idx_workout_user
ON Workout(user_id);

selectWorkoutsByUser:
    SELECT *
    FROM Workout
    WHERE user_id = ?
      AND archived_at IS NULL
    ORDER BY updated_at DESC;

selectWorkoutById:
    SELECT *
    FROM Workout
    WHERE id = ?
      AND user_id = ?;

insertWorkout:
    INSERT INTO Workout (
        id,
        user_id,
        name,
        description,
        estimated_time,
        created_at,
        updated_at,
        archived_at
    )
    VALUES (?, ?, ?, ?, ?, ?, ?, NULL);

updateWorkout:
    UPDATE Workout
    SET
        name = ?,
        description = ?,
        estimated_time = ?,
        updated_at = ?
    WHERE id = ?
      AND user_id = ?
      AND archived_at IS NULL;

archiveWorkout:
UPDATE Workout
SET
    archived_at = ?,
    updated_at = ?
WHERE id = ?
  AND user_id = ?
  AND archived_at IS NULL;

restoreWorkout:
UPDATE Workout
SET
    archived_at = NULL,
    updated_at = ?
WHERE id = ?
  AND user_id = ?
  AND archived_at IS NOT NULL;

selectAllWorkoutsByUser:
SELECT *
FROM Workout
WHERE user_id = ?
ORDER BY updated_at DESC;
