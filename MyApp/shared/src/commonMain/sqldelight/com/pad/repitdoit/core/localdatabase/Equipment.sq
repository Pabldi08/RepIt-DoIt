
CREATE TABLE Equipment (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    is_active INTEGER NOT NULL DEFAULT 1
        CHECK (is_active IN (0, 1)),
    updated_at INTEGER NOT NULL
);

selectAllEquipment:
SELECT *
FROM Equipment
WHERE is_active = 1
ORDER BY name ASC;

selectEquipmentById:
SELECT *
FROM Equipment
WHERE id = ?;

insertEquipment:
INSERT INTO Equipment (
    id,
    name,
    description,
    is_active,
    updated_at
)
VALUES (?, ?, ?, ?, ?);