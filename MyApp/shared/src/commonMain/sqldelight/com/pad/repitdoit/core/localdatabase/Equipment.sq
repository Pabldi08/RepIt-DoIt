
CREATE TABLE Equipment (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL CHECK (length(trim(name)) > 0),
    description TEXT,
    is_active INTEGER NOT NULL DEFAULT 1
        CHECK (is_active IN (0, 1)),
    updated_at INTEGER NOT NULL
);

selectAllEquipment:
SELECT *
FROM Equipment
WHERE is_active = 1
ORDER BY name ASC;

selectEquipmentById:
SELECT *
FROM Equipment
WHERE id = ?;

insertEquipment:
INSERT INTO Equipment (
    id,
    name,
    description,
    is_active,
    updated_at
)
VALUES (?, ?, ?, ?, ?);

updateEquipment:
UPDATE Equipment
SET name = :name,
    description = :description,
    is_active = :is_active,
    updated_at = :updated_at
WHERE id = :id;

-- Ordinary removal is logical; existing references are retained.
deactivateEquipment:
UPDATE Equipment SET is_active = 0, updated_at = :updated_at WHERE id = :id;
