
CREATE TABLE Exercise (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    image_url TEXT,
    video_url TEXT,
    is_active INTEGER NOT NULL DEFAULT 1
        CHECK (is_active IN (0, 1)),
    updated_at INTEGER NOT NULL
);

selectAllExercises:
    SELECT *
    FROM Exercise
    WHERE is_active = 1
    ORDER BY name ASC;

selectExerciseById:
    SELECT *
    FROM Exercise
    WHERE id = ?;

insertExercise:
    INSERT INTO Exercise (
        id,
        name,
        description,
        image_url,
        video_url,
        is_active,
        updated_at
    )
    VALUES(?,?,?,?,?,?,?);

updateExercise:
    UPDATE Exercise
    SET
        name = ?,
        description = ?,
        image_url = ?,
        video_url = ?,
        is_active = ?,
        updated_at = ?
    WHERE id = ?;
